{
  "name": "case-diary",
  "version": "2.0.0",
  "private": true,
  "description": "Advocate personal case diary (Bangla) - Android app",
  "scripts": {
    "build:web": "esbuild src/cloud.js --bundle --minify --format=iife --target=es2019 --outfile=www/cloud.js",
    "sync": "npm run build:web && cap sync android",
    "assets": "capacitor-assets generate --android",
    "serve": "npx http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "firebase": "^13.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.2"
  }
}
