rules_version = '2';

// কেস ডায়েরি — Firestore নিরাপত্তা নিয়ম।
// Firebase Console → Firestore Database → Rules ট্যাবে পুরোটা পেস্ট করে Publish করুন।
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function chamberPath(cid) { return /databases/$(database)/documents/chambers/$(cid); }
    // সুপার অ্যাডমিন (অ্যাপের মালিক) — ইমেইল বদলাতে চাইলে এখানে বদলান
    function isSuper() { return signedIn() && request.auth.token.email == 'fahadtaukir@gmail.com'; }
    function memberDoc(cid) { return /databases/$(database)/documents/chambers/$(cid)/members/$(request.auth.uid); }
    // ব্লক করা সদস্য কোনো তথ্য দেখতে/লিখতে পারবে না
    function isMember(cid) { return signedIn() && exists(memberDoc(cid)) && get(memberDoc(cid)).data.get('blocked', false) != true; }
    function isAdmin(cid) {
      return signedIn() && get(/databases/$(database)/documents/chambers/$(cid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // কে কোন চেম্বারে আছে তার ইঙ্গিত (শুধু নিজে দেখতে/লিখতে পারবে)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isSuper();
      allow delete: if isSuper();
    }

    // বার্তা ও আপডেট নোটিশ: সবাই পড়তে পারে, লিখতে পারে শুধু সুপার অ্যাডমিন
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuper();
    }

    // যোগ দেওয়ার কোড: কেউ একটি নির্দিষ্ট কোড খুঁজতে পারবে, কিন্তু তালিকা দেখতে পারবে না
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSuper();
    }

    match /chambers/{cid} {
      allow read: if isMember(cid) || isSuper();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin(cid);
      allow delete: if isSuper();

      match /members/{uid} {
        allow read: if isMember(cid) || isSuper() || (signedIn() && request.auth.uid == uid);
        // অ্যাডভোকেট নিজের চেম্বারে নিজেকে যোগ করতে পারবে; ক্লার্ক সঠিক কোড দিয়ে নিজেকে যোগ করতে পারবে
        allow create: if signedIn() && request.auth.uid == uid && (
          (request.resource.data.role == 'admin' && get(chamberPath(cid)).data.ownerUid == uid) ||
          (request.resource.data.role == 'clerk' && request.resource.data.code == get(chamberPath(cid)).data.code)
        );
        allow update: if isAdmin(cid) || isSuper()
                      || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
        // অ্যাডভোকেট ক্লার্ককে সরাতে পারবে; ক্লার্ক নিজে বের হতে পারবে
        allow delete: if isSuper() || (isAdmin(cid) && uid != request.auth.uid)
                      || (signedIn() && request.auth.uid == uid && resource.data.role == 'clerk');
      }

      // মামলা, তারিখের রেকর্ড, মক্কেল — চেম্বারের সবাই (অ্যাডভোকেট ও ক্লার্ক) দেখতে ও লিখতে পারবে
      match /{coll}/{docId} {
        allow read, write: if coll in ['cases', 'hearings', 'clients'] && isMember(cid);
        // সুপার অ্যাডমিন শুধু চেম্বার মোছার সময় এগুলো পড়তে/মুছতে পারে
        allow read, delete: if isSuper();
      }

      // ফি-র হিসাব — শুধু অ্যাডভোকেট (ক্লার্ক দেখতে বা লিখতে পারবে না)
      match /fees/{docId} {
        allow read, write: if isAdmin(cid);
        allow read, delete: if isSuper();
      }

      // আদালতের তালিকা — সবাই দেখতে পারবে, বদলাতে পারবে শুধু অ্যাডভোকেট
      match /courts/{docId} {
        allow read: if isMember(cid);
        allow write: if isAdmin(cid);
        allow read, delete: if isSuper();
      }
    }
  }
}
